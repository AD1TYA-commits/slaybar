{
  "layer": "top",
  "position": "top",
  "height": 42,
  "spacing": 8,
  "margin-top": 0,
  "margin-left": 8,
  "margin-right": 8,
  "exclusive": true,
  "fixed-center": true,
  "modules-left": ["niri/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["network", "bluetooth", "pulseaudio", "backlight", "cpu", "memory", "battery"],

  "niri/workspaces": {
    "format": "{icon}",
    "current-only": true,
    "format-icons": {
      "1": "一", "2": "二", "3": "三", "4": "四", "5": "五",
      "6": "六", "7": "七", "8": "八", "9": "九", "10": "十",
      "default": "一"
    }
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  "network": {
    "format-wifi": "{essid}",
    "format-ethernet": "Ethernet",
    "format-disconnected": "Disconnected",
    "tooltip-format": "{ifname}: {ipaddr}"
  },

  "bluetooth": {
    "format": "{status}",
    "format-connected": "Connected",
    "format-disabled": "Disabled",
    "format-off": "Off"
  },

  "pulseaudio": {
    "format": "{volume}%",
    "format-muted": "Muted",
    "on-click": "pavucontrol"
  },

  "backlight": {
    "format": "{percent}%"
  },

  "cpu": {
    "format": "{usage}%"
  },

  "memory": {
    "format": "{percentage}%"
  },

  "battery": {
    "format": "{capacity}%",
    "format-charging": "{capacity}%",
    "format-plugged": "{capacity}% plugged",
    "states": {
      "warning": 30,
      "critical": 15
    }
  }
}
